# Copy to release-config.env and fill in for YOUR app.
# release-config.env is gitignored — never commit real values.
# Source it before running the scripts:  set -a; source release-config.env; set +a

# ---- App / project ----
APP_DIR="/absolute/path/to/your/flutter/app"   # dir containing pubspec.yaml
ENV_FILE=".env"                                 # dart-define env file, relative to APP_DIR or absolute

# ---- iOS (App Store Connect) ----
IOS_BUNDLE_ID="com.example.app"                 # optional; Transporter reads it from the IPA
ASC_ISSUER_ID="00000000-1111-2222-3333-444444444444"   # App Store Connect > Users and Access > Integrations
ASC_KEY_ID="XXXXXXXXXX"                          # 10-char API key id
ASC_P8_PATH="/absolute/path/to/AuthKey_XXXXXXXXXX.p8"
# Optional prebuilt JSON instead of the three fields above:
# ASC_API_KEY_JSON="/absolute/path/to/appstoreconnect.json"

# ---- Android (Google Play) ----
ANDROID_PACKAGE_NAME="com.example.app"
PLAY_JSON_KEY="/absolute/path/to/google-play-service-account.json"
PLAY_TRACK="internal"                            # internal | alpha | beta | production
